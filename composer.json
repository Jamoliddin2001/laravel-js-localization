{
  "name": "jamoliddin-firdavs/js-localization",
  "description": "Laravel package to provide localizations to the Javascript code.",
  "keywords": [
    "laravel",
    "javascript",
    "localization",
    "translation",
    "messages"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Andy Wermke",
      "email": "andy@dev.next-step-software.com"
    }
  ],
  "require": {
    "php": ">=7.3.0",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "~1.0"
  },
  "autoload": {
    "psr-4": {
      "JsLocalization\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "extra": {
    "component": "package",
    "frameworks": [
      "Laravel 7",
      "Laravel 8",
      "Laravel 9",
      "Laravel 10",
      "Laravel 11"
    ]
  },
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "vcs",
      "url": "git://github.com/orchestral/phpseclib.git"
    }
  ]
}
